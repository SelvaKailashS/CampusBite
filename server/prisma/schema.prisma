generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @default("")
  name         String   @default("")
  dept         String   @default("")
  year         String   @default("")
  role         String   @default("student")
  canteenId    String?
  canteen      Canteen? @relation(fields: [canteenId], references: [id])
  wallet       Int      @default(450)
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Canteen {
  id          String  @id
  name        String
  emoji       String
  logoUrl     String  @default("")
  location    String  @default("")
  status      String  @default("open")
  rating      Float   @default(4.5)
  waitMin     Int     @default(5)
  waitMax     Int     @default(15)
  priceMin    Int     @default(20)
  priceMax    Int     @default(100)
  speciality  String  @default("")
  tagline     String  @default("")
  gradient    String  @default("")
  accent      String  @default("")
  ordersAhead Int     @default(0)
  foods       Food[]
  orders      Order[]
  users       User[]
}

model Food {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  canteenId   String
  canteen     Canteen  @relation(fields: [canteenId], references: [id], onDelete: Cascade)
  name        String
  price       Int
  emoji       String
  imageUrl    String   @default("")
  category    String   @default("meals")
  diet        String   @default("veg")
  popular     Boolean  @default(false)
  protein     Int?
  calories    Int?
  description String   @default("")
  healthTags  String[] @default([])
  bg          String   @default("bg-stone-50")
  available   Boolean  @default(true)
  orderItems  OrderItem[]
}

model Order {
  id            Int      @id @default(autoincrement())
  token         String
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  canteenId     String
  canteen       Canteen  @relation(fields: [canteenId], references: [id])
  total         Int
  mode          String
  block         String?
  room          String?
  rowNum        Int?
  desk          Int?
  payment       String
  paymentStatus String   @default("pending")
  stage         Int      @default(0)
  etaMin        Int      @default(10)
  studentName   String   @default("")
  placedAt      DateTime @default(now())
  items         OrderItem[]

  @@index([userId])
  @@index([canteenId])
  @@index([stage])
}

model OrderItem {
  id      Int    @id @default(autoincrement())
  orderId Int
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodId  Int
  food    Food   @relation(fields: [foodId], references: [id])
  name    String
  emoji   String
  price   Int
  qty     Int
}